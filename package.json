{
  "name": "organization-ticketing-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "bootstrap": "node --env-file=.env scripts/bootstrap.js",
    "test": "node --test test/*.test.js",
    "ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "cors": "2.8.6",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.3",
    "zod": "4.6.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
